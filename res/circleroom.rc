// GLFW picks up the resource named GLFW_ICON for the window/taskbar icon; MAINICON names the exe.
GLFW_ICON ICON "circleroom.ico"
MAINICON ICON "circleroom.ico"

#include "../src/version.h"

1 VERSIONINFO
FILEVERSION CR_VER_MAJOR,CR_VER_MINOR,CR_VER_PATCH,0
PRODUCTVERSION CR_VER_MAJOR,CR_VER_MINOR,CR_VER_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Circle Room"
      VALUE "FileDescription", "Circle Room photo editor"
      VALUE "OriginalFilename", "CircleRoom.exe"
      VALUE "FileVersion", CR_VERSION_STR
      VALUE "ProductVersion", CR_VERSION_NAME
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
