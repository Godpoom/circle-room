// GLFW picks up the resource named GLFW_ICON for the window/taskbar icon; MAINICON names the exe.
GLFW_ICON ICON "circleroom.ico"
MAINICON ICON "circleroom.ico"

1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Circle Room"
      VALUE "FileDescription", "Circle Room photo editor"
      VALUE "OriginalFilename", "CircleRoom.exe"
      VALUE "FileVersion", "1.0.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
